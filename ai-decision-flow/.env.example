# Local Inngest development mode.
# Safe to commit: this is not a secret.
INNGEST_DEV=1

# LLM configuration.
# Put real values in .env.local, never in Git.
OPENAI_API_KEY=

# Optional: leave empty for OpenAI.
# Set this for an OpenAI-compatible provider.
OPENAI_BASE_URL=

# Optional: defaults to gpt-4o-mini.
OPENAI_MODEL=

# Required only when using Inngest Cloud.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=